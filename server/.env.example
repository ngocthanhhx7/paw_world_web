# Server
NODE_ENV=development
PORT=5000

# MongoDB
# Local:
# MONGODB_URI=mongodb://127.0.0.1:27017/paw_world
#
# MongoDB Atlas (SRV - cần DNS hỗ trợ SRV record):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/paw_world?retryWrites=true&w=majority&appName=PawWorld
#
# Nếu gặp lỗi `querySrv ECONNREFUSED` (DNS local chặn SRV), dùng dạng multi-host:
# MONGODB_URI=mongodb://<user>:<pass>@host-00:27017,host-01:27017,host-02:27017/<db>?ssl=true&replicaSet=<rs>&authSource=admin&retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/paw_world


# Auth
JWT_SECRET=paw_world_super_secret_change_me
JWT_EXPIRES_IN=7d

# CORS
CLIENT_ORIGIN=http://localhost:5173
CLIENT_PUBLIC_URL=https://pawworldvn.shop

# Social login
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# payOS online bank transfer
# Webhook URL to configure in payOS:
# https://pawworldvn.shop/api/orders/payos/webhook
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# PAWWORLD GENIUS AI (ShineShop OpenAI-compatible API)
SHINESHOP_DEV_API_KEY=sk-your-key
SHINESHOP_DEV_BASE_URL=https://api.shineshop.dev/v1
SHINESHOP_DEV_MODEL=your-model-id
GEMINI_API_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.1-flash-lite
CHATBOT_MAX_TOKENS=900
CHATBOT_TEMPERATURE=0.35
CHATBOT_PROVIDER_TIMEOUT_MS=30000

# Default admin (dùng khi seed)
SEED_ADMIN_EMAIL=admin@pawworld.vn
SEED_ADMIN_PASSWORD=pawworld@123
SEED_ADMIN_NAME=Paw World Admin

# Email (SMTP)
# Gmail: bật 2FA và tạo App Password tại https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=PawWorld <your-email@gmail.com>
# CLIENT_RESET_PASSWORD_URL=https://pawworldvn.shop/dat-lai-mat-khau

